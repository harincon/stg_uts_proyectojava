<%@ page pageEncoding="UTF-8" %>
<%-- MODELO: tabla estudiantes.
       inscripcionDeUsuario   entrada: idUsuario                                         salida: inscripcion
       contarPendientes                                                                  salida: pendientes
       listarPendientes                                                                  salida: inscripcionesPendientes
       crearAprobado          entrada: idObjetivo, idProgramaNuevo, semestreNuevo, idUsuario (revisor)
       crearPendiente         entrada: idObjetivo, idProgramaNuevo, semestreNuevo
       actualizarPrograma     entrada: idObjetivo, idProgramaNuevo, semestreNuevo
       reenviar               entrada: idObjetivo, idProgramaNuevo, semestreNuevo        salida: filasActualizadas
                              (solo si la inscripción está RECHAZADA; queda PENDIENTE)
       decidir                entrada: idEstudianteObjetivo, decision, observacion, idUsuario (revisor)
                              salida: filasActualizadas (solo decide inscripciones PENDIENTE)
       buscarCompanero        entrada: prefijoIdentificacion, idUsuario                  salida: sugerenciasCompanero
                              (máximo 5: aprobados, activos, sin proyecto en curso, distintos del usuario)
       obtenerPorIdentificacion  entrada: identificacionBuscada                          salida: companero --%>
<c:choose>
    <c:when test="${operacion eq 'inscripcionDeUsuario'}">
        <sql:query var="inscripcion" scope="request">
            SELECT e.id_estudiante, e.estado_inscripcion, e.observacion_inscripcion, e.semestre, e.id_programa,
                   e.fecha_revision, p.nombre AS programa,
                   u.nombres, u.apellidos, u.identificacion, u.correo
            FROM estudiantes e
            JOIN programas p ON p.id_programa = e.id_programa
            JOIN usuarios u ON u.id_usuario = e.id_usuario
            WHERE e.id_usuario = ?
            <sql:param value="${idUsuario}"/>
        </sql:query>
    </c:when>
    <c:when test="${operacion eq 'contarPendientes'}">
        <sql:query var="pendientes" scope="request">
            SELECT COUNT(*) AS total FROM estudiantes WHERE estado_inscripcion = 'PENDIENTE'
        </sql:query>
    </c:when>
    <c:when test="${operacion eq 'listarPendientes'}">
        <sql:query var="inscripcionesPendientes" scope="request">
            SELECT e.id_estudiante, e.semestre, e.observacion_inscripcion, p.nombre AS programa,
                   u.nombres, u.apellidos, u.identificacion, u.correo, u.fecha_registro
            FROM estudiantes e
            JOIN usuarios u ON u.id_usuario = e.id_usuario
            JOIN programas p ON p.id_programa = e.id_programa
            WHERE e.estado_inscripcion = 'PENDIENTE' AND u.activo = TRUE
            ORDER BY u.fecha_registro
        </sql:query>
    </c:when>
    <c:when test="${operacion eq 'crearAprobado'}">
        <sql:update>
            INSERT INTO estudiantes (id_usuario, id_programa, semestre, estado_inscripcion, id_revisor, fecha_revision)
            VALUES (?, ?, ?, 'APROBADO', ?, CURRENT_TIMESTAMP)
            <sql:param value="${idObjetivo}"/>
            <sql:param value="${idProgramaNuevo}"/>
            <sql:param value="${semestreNuevo}"/>
            <sql:param value="${idUsuario}"/>
        </sql:update>
    </c:when>
    <c:when test="${operacion eq 'crearPendiente'}">
        <sql:update>
            INSERT INTO estudiantes (id_usuario, id_programa, semestre) VALUES (?, ?, ?)
            <sql:param value="${idObjetivo}"/>
            <sql:param value="${idProgramaNuevo}"/>
            <sql:param value="${semestreNuevo}"/>
        </sql:update>
    </c:when>
    <c:when test="${operacion eq 'actualizarPrograma'}">
        <sql:update>
            UPDATE estudiantes SET id_programa = ?, semestre = ? WHERE id_usuario = ?
            <sql:param value="${idProgramaNuevo}"/>
            <sql:param value="${semestreNuevo}"/>
            <sql:param value="${idObjetivo}"/>
        </sql:update>
    </c:when>
    <c:when test="${operacion eq 'reenviar'}">
        <sql:update var="filasActualizadas" scope="request">
            UPDATE estudiantes
            SET id_programa = ?, semestre = ?, estado_inscripcion = 'PENDIENTE'
            WHERE id_usuario = ? AND estado_inscripcion = 'RECHAZADO'
            <sql:param value="${idProgramaNuevo}"/>
            <sql:param value="${semestreNuevo}"/>
            <sql:param value="${idObjetivo}"/>
        </sql:update>
    </c:when>
    <c:when test="${operacion eq 'decidir'}">
        <sql:update var="filasActualizadas" scope="request">
            UPDATE estudiantes
            SET estado_inscripcion = ?, observacion_inscripcion = NULLIF(?, ''), id_revisor = ?, fecha_revision = CURRENT_TIMESTAMP
            WHERE id_estudiante = ? AND estado_inscripcion = 'PENDIENTE'
            <sql:param value="${decision}"/>
            <sql:param value="${observacion}"/>
            <sql:param value="${idUsuario}"/>
            <sql:param value="${idEstudianteObjetivo}"/>
        </sql:update>
    </c:when>
    <c:when test="${operacion eq 'buscarCompanero'}">
        <sql:query var="sugerenciasCompanero" scope="request">
            SELECT e.id_estudiante, u.nombres || ' ' || u.apellidos AS nombre, u.identificacion,
                   p.nombre AS programa, e.semestre
            FROM estudiantes e
            JOIN usuarios u ON u.id_usuario = e.id_usuario
            JOIN programas p ON p.id_programa = e.id_programa
            WHERE u.identificacion LIKE ? || '%'
              AND e.estado_inscripcion = 'APROBADO' AND u.activo = TRUE AND e.id_usuario <> ?
              AND NOT EXISTS (SELECT 1 FROM proyecto_estudiantes pe
                              JOIN proyectos pr ON pr.id_proyecto = pe.id_proyecto
                              WHERE pe.id_estudiante = e.id_estudiante AND pr.estado = 'EN_CURSO')
            ORDER BY u.identificacion
            LIMIT 5
            <sql:param value="${prefijoIdentificacion}"/>
            <sql:param value="${idUsuario}"/>
        </sql:query>
    </c:when>
    <c:when test="${operacion eq 'obtenerPorIdentificacion'}">
        <sql:query var="companero" scope="request">
            SELECT e.id_estudiante, e.id_usuario, e.estado_inscripcion, u.activo
            FROM estudiantes e
            JOIN usuarios u ON u.id_usuario = e.id_usuario
            WHERE u.identificacion = ?
            <sql:param value="${identificacionBuscada}"/>
        </sql:query>
    </c:when>
</c:choose>
