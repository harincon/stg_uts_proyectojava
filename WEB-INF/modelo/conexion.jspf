<%@ page pageEncoding="UTF-8" %>
<%-- MODELO: conexión a PostgreSQL por defecto para todas las etiquetas sql.
     Los datos se leen de las variables de entorno DB_URL, DB_USER y DB_PASSWORD. --%>
<sql:setDataSource driver="org.postgresql.Driver"
                   url="${System.getenv('DB_URL')}"
                   user="${System.getenv('DB_USER')}"
                   password="${System.getenv('DB_PASSWORD')}"
                   scope="application"/>
